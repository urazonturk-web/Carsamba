    }
  }
  return null;
}

// Duruş döngüsü: 0 tünemiş, 1 bakış, 2 yem. t = ms saat.
export function kargaPoz(t: number, seed: number) {
  "worklet";
  const period = 6000 + seed * 4000;
  const ph = ((t + seed * 9000) % period) / period;
