export const DAILY_MAP = false as boolean;
export const DAILY_KEY = "carsamba.daily.v1";

export type DailyRecord = { date: string; best: number; farthest: number };

const AYLAR = ["Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık"];

export function todayKey(d = new Date()) {
  const m = `${d.getMonth() + 1}`.padStart(2, "0");
  const day = `${d.getDate()}`.padStart(2, "0");
  return `${d.getFullYear()}-${m}-${day}`;
}

export function todayLabel(d = new Date()) {
  return `${d.getDate()} ${AYLAR[d.getMonth()]}`;
}

/** Tarih anahtarından 32-bit tohum (FNV-1a). Aynı gün = aynı harita. */
export function dailySeed(key = todayKey()) {
  let h = 0x811c9dc5;
  const s = `gunun-haritasi:${key}`;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h >>> 0;
}
// MEYDAN OKUMA (2026-11-16, kullanıcı: "2 kişi oynayabilmek", seçim "İkisi de": önce meydan okuma).
// Bir koşunun harita tohumu + skoru kısa bir koda dönüşür; arkadaş kodu girince aynı
// haritayı oynar (kule dizisi, kurukafa yerleri ve etkileri tohumdan gelir) ve sonuç karşılaştırılır.
// Sunucu yok; kod mesajla paylaşılır. Not: kule dizisi telefon genişliğinden çok az etkilenebilir.

export const MEYDAN_ON = true as boolean;

export type Challenge = { seed: number; target: number; from: string; matchID?: string };

/** Tohum (32 bit) -> 7 karakter base36, büyük harf; skor ondalık. Örn. "1K9Z0QX-37". */
export function makeCode(seed: number, score: number) {
  return `${(seed >>> 0).toString(36).toUpperCase()}-${Math.max(0, Math.floor(score))}`;
}

/** Kullanıcının yazdığı kodu çöz; boşluk ve küçük harf serbest. Geçersizse null. */
export function parseCode(raw: string): { seed: number; target: number } | null {
  const t = raw.trim().toUpperCase().replace(/\s+/g, "").replace(/[–—_]/g, "-");
  const m = t.match(/([0-9A-Z]{1,7})-(\d{1,5})/);
  if (!m) return null;
  const seed = parseInt(m[1], 36);
  if (!Number.isFinite(seed) || seed < 0 || seed > 0xffffffff) return null;
  return { seed: seed >>> 0, target: parseInt(m[2], 10) };
}

export function shareText(code: string, score: number, name: string) {
  const who = name ? `${name} diyor ki: ` : "";
  return `${who}Byzantion'da beni geç! ${score} puan yaptım 💪\nMeydan okuma kodu: ${code}\nOyunu aç → oyun sonunda "🔑 Kod gir" → kodu yaz.`;
}
// HAYALET YARIŞ (2026-11-16)
// Kullanıcı: "aynı haritada birbirlerinin zıplamalarını görerek oynayacakları 3 dakikalık bir oyun;
// yanan tekrar baştan başlıyor; en sonunda kim ne kadar puan yapmış ve en uzağa gitmişse".
// Karar: önce asenkron hayalet yarış. Kazanan = tek koşuda en uzak kule; eşitlikte en iyi koşu puanı.
// Rakibin zıplamaları kule kimliği + kule üstündeki oranla kaydedilir (ekran genişliği farkı yüzünden
// mutlak x gönderilmez; bkz. ai_review_evidence/ONLINE-YARIS-2026-11-16/RAPOR.md).

export const YARIS_ON = true;
export const RACE_MS = 120_000; // kullanıcı: "3 dakika çok uzun" -> 2 dk
export const RESPAWN_MS = 700;

// Olay türleri
export const EV_LAUNCH = 0;
export const EV_LAND = 1;
export const EV_FALL = 2;
export const EV_RESPAWN = 3;

/** Düz dizi: [t, tür, kule, oran*1000] tekrarları. t = yarış başından ms. */
export type RaceLog = number[];

export type RaceSummary = { far: number; best: number; runs: number };
export type RaceData = RaceSummary & { v: 1; log: RaceLog };

export function pushEvent(log: RaceLog, t: number, kind: number, tower = 0, ratio = 0) {
  log.push(Math.max(0, Math.round(t)), kind, tower | 0, Math.round(Math.max(-1, Math.min(2, ratio)) * 1000));
}

export function encodeRace(d: RaceSummary, log: RaceLog): string {
  const data: RaceData = { v: 1, far: d.far, best: d.best, runs: d.runs, log };
  return JSON.stringify(data);
}

export function decodeRace(raw?: string | null): RaceData | null {
  if (!raw) return null;
  try {
    const d = JSON.parse(raw);
    if (!d || d.v !== 1 || !Array.isArray(d.log)) return null;
    return { v: 1, far: d.far | 0, best: d.best | 0, runs: d.runs | 0, log: d.log.map((n: any) => +n || 0) };
  } catch {
    return null;
  }
}

/** 1 = a kazandı, -1 = b kazandı, 0 = berabere. */
export function compareRace(a: RaceSummary, b: RaceSummary): number {
  if (a.far !== b.far) return a.far > b.far ? 1 : -1;
  if (a.best !== b.best) return a.best > b.best ? 1 : -1;
  return 0;
}

export function clockText(ms: number): string {
  const s = Math.max(0, Math.ceil(ms / 1000));
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
}

