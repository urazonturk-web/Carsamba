import { jumpVelocity, flightGravity } from "./jump";
import { isStopTower } from "./stops";

// Görsel: Kıvılcım (1 çağrı), kullanıcı kabulü 2026-11-16 ("Evet, kabul"; gece külahlı hâli).
export const KURUKAFA_ON = true as boolean;
export const SKULL_SOURCE = require("@/assets/environment/kurukafa/kurukafa.png");

// 2026-11-16 kullanıcı: "random olsun" -> çıkış yeri, yükseklik, etki oranı ve süre rastgele.
export const SKULL_SCALE_MIN = 0.1; // etki oranı %10..%30 arası rastgele (büyüme ya da küçülme)
export const SKULL_SCALE_MAX = 0.3;
export const SKULL_JUMPS_MIN = 3; // etki 3..8 iniş arası rastgele
export const SKULL_JUMPS_MAX = 8;
// 2026-11-22 kullanıcı: "12. kuleden sonra değil random olsun; bir kurukafanın süresi bitmeden diğeri çıkmasın"
// -> 4. kuleden itibaren rastgele; etki sürerken yeni kurukafa gösterilmez (app/index.tsx, effectLeft kapısı).
export const SKULL_MIN_ID = 4;
export const SKULL_CHANCE = 0.2; // her boşlukta olasılık; ardışık engeli ile ~12-13 kulede bir
export const SKULL_MIN_GAP = 4; // kullanıcı: "peş peşe de çıkmasın" -> iki kurukafa arası en az 4 kule
export const SKULL_LIFT_MIN = 180; // doğal yay tepesinin üstünde rastgele yükseklik: alçak = kolay,
export const SKULL_LIFT_MAX = 330; // yüksek = uzun basış ister
// Kullanıcı (video 12-42-57): "değince alması lazım" -> toplama, kurukafa dairesi ile
// amcanın çizilen gövdesi (dikdörtgen) değince olur; eskiden merkeze 34 birim gerekiyordu.
export const SKULL_HIT_R = 0.42; // kurukafa çizim boyunun bu oranı kadar yarıçap
export const SKULL_SIZE = 110; // çizim boyu (dünya birimi; kamera 0,4 ile ekranda ~44 nokta)

export function skullHash(seed: number, id: number) {
  "worklet";
  let h = Math.imul((seed ^ 0x9e3779b9) | 0, 0x85ebca6b) ^ Math.imul(id + 0x632be5ab, 0xc2b2ae35);
  h ^= h >>> 15;
  h = Math.imul(h, 0x2c1b3c6d);
  h ^= h >>> 12;
  h = Math.imul(h, 0x297a2d39);
  h ^= h >>> 15;
  return (h >>> 0) / 4294967296;
}

function baseSkull(seed: number, id: number) {
  "worklet";
  return id >= SKULL_MIN_ID && !isStopTower(id) && !isStopTower(id + 1) && skullHash(seed, id) < SKULL_CHANCE;
}

/** id kulesinden sonraki boşlukta kurukafa var mı? Rastgele, ama önceki SKULL_MIN_GAP boşlukta yoksa. */
export function skullAfter(seed: number, id: number) {
  "worklet";
  if (!baseSkull(seed, id)) return false;
  for (let j = id - SKULL_MIN_GAP; j < id; j++) if (baseSkull(seed, j)) return false;
  return true;
}

/** Kurukafa dairesi amcanın gövde dikdörtgenine değiyor mu? */
export function skullTouches(sx: number, sy: number, r: number, left: number, top: number, right: number, bottom: number) {
  "worklet";
  const cx = Math.max(left, Math.min(sx, right));
  const cy = Math.max(top, Math.min(sy, bottom));
  const dx = sx - cx;
  const dy = sy - cy;
  return dx * dx + dy * dy <= r * r;
}

/** Bu kurukafanın yay tepesinin ne kadar üstünde duracağı (rastgele, tohumla sabit). */
export function skullLift(seed: number, id: number) {
  "worklet";
  return SKULL_LIFT_MIN + skullHash(seed ^ 0x5bd1e995, id) * (SKULL_LIFT_MAX - SKULL_LIFT_MIN);
}

/** Alındığı an: çarpan (×0,7..0,9 ya da ×1,1..1,3) ve süre (3..8 iniş). Haritanın tohumu ve
 *  kurukafanın kulesinden türetilir: aynı haritayı oynayan iki kişi aynı etkiyi alır (meydan okuma). */
export function rollSkullEffect(seed: number, id: number) {
  "worklet";
  const mag = SKULL_SCALE_MIN + skullHash(seed ^ 0x27d4eb2f, id) * (SKULL_SCALE_MAX - SKULL_SCALE_MIN);
  const k = skullHash(seed ^ 0x165667b1, id) < 0.5 ? 1 + mag : 1 - mag;
  const jumps = SKULL_JUMPS_MIN + Math.floor(skullHash(seed ^ 0x3c6ef372, id) * (SKULL_JUMPS_MAX - SKULL_JUMPS_MIN + 1));
  return { k, jumps };
}

type P = { x: number; topY: number; width: number };

/** prev kulesinin ortasından next kulesinin ortasına inen zıplamanın yay tepesi (+lift). */
export function skullPoint(prev: P, next: P, halfH: number, screenWidth: number, lift: number) {
  "worklet";
  const g = flightGravity(screenWidth);
  const x0 = prev.x + prev.width / 2;
  const targetDx = next.x + next.width / 2 - x0;
  const dy = next.topY - prev.topY;
  let lo = 0;
  let hi = 1;
  for (let k = 0; k < 24; k++) {
    const c = (lo + hi) / 2;
    const v = jumpVelocity(c, screenWidth);
    const disc = v.vy * v.vy + 2 * g * dy;
    const t = (-v.vy + Math.sqrt(Math.max(0, disc))) / g;
    if (v.vx * t < targetDx) lo = c;
    else hi = c;
  }
  const v = jumpVelocity((lo + hi) / 2, screenWidth);
  const ta = -v.vy / g;
  return { x: x0 + v.vx * ta, y: prev.topY - halfH + v.vy * ta + 0.5 * g * ta * ta - lift };
}

/** Etkin iniş genişliği: kule ortası sabit, genişlik × k. */
export function scaledPlatforms<T extends P>(list: readonly T[], k: number): T[] {
  "worklet";
  const out: T[] = [];
  for (let i = 0; i < list.length; i++) {
    const p = list[i];
    out.push({ ...p, x: p.x + (p.width * (1 - k)) / 2, width: p.width * k });
  }
  return out;
}
// DURAK SEFERİ (2026-11-12, kullanıcı: "Evet, başla"; YAPI-2026-11-12 raporu).
// Sonsuz koşunun içine duraklar: her 15 kulede bir (15, 30, 45, 60…).
// 4. durak iskele ("vapura yetiştin"); sonrası "Gece seferi N" olarak sürer.
// Kayıt noktası yok: düşünce baştan başlanır. Durak puan vermez (ilk deneme).
// Zorluk her durakta bir basamak artar (procedural-course.ts); fizik değişmez.
// Kule kimliği (platform id) üzerinden çalışır, skor üzerinden değil.

export const DURAK_SEFER = true as boolean;

// 2026-11-12 kullanıcı (video 12-23-01): "baştan 15. kolona vardığında durak yazsa daha
// tutarlı olur" -> ilk durak da 15. kulede; duraklar 15, 30, 45, 60 (iskele), 75…
export const FIRST_STOP = 15;
export const STOP_EVERY = 15;

// GÜZERGÂH 2026-11-16 (kullanıcı: "Evet, geçir"; ai_review_evidence/GUZERGAH-2026-11-16/RAPOR.md):
// Kadıköy'den Boğaz boyunca kuzeye, üç köprüyle Karadeniz'e. Önceki duraklar:
// Karaköy, Galata, Sirkeci, Eminönü İskelesi (PIER_STOP 4 = iskele + zorluk tavanı).
export const START_NAME = "Kadıköy";
export const STOP_NAMES = [
  "Harem", "Üsküdar · Kız Kulesi", "Kuzguncuk", "Beylerbeyi",
  "Ortaköy", "Arnavutköy", "Bebek", "Rumeli Hisarı",
  "Kanlıca", "Beykoz", "Anadolu Kavağı", "Rumeli Feneri",
] as const;
// Sonuç kartındaki "…'e N kule kaldı" için yönelme hâlleri (ünlü uyumu elle).
const STOP_DATIVE = [
  "Harem'e", "Üsküdar'a", "Kuzguncuk'a", "Beylerbeyi'ne",
  "Ortaköy'e", "Arnavutköy'e", "Bebek'e", "Rumeli Hisarı'na",
  "Kanlıca'ya", "Beykoz'a", "Anadolu Kavağı'na", "Rumeli Feneri'ne",
] as const;
/** Son durak (büyük final: "Karadeniz'e ulaştın!"); sonrası "Gece seferi N". */
export const FINAL_STOP = STOP_NAMES.length;
/** Zorluk tavanı: önceki gibi 4. durakta (isimlerden bağımsız; zorluk değişmez). */
export const DIFFICULTY_CAP_STOP = 4;

/** Köprüler: `foot` durağından sonraki kuleler köprü üstü sayılır, `to` durağında karşı yakadasın. */
export const BRIDGES = [
  { foot: 4, to: 5, name: "Boğaziçi Köprüsü", from: "Anadolu", side: "Avrupa", arrive: "Avrupa yakasına geçtin!" },
  { foot: 8, to: 9, name: "Fatih Sultan Mehmet Köprüsü", from: "Avrupa", side: "Anadolu", arrive: "Anadolu yakasına döndün!" },
  { foot: 11, to: 12, name: "Yavuz Sultan Selim Köprüsü", from: "Anadolu", side: "Avrupa", arrive: "Karadeniz'e ulaştın!" },
] as const;

/** Bu kule bir köprünün üstünde mi? (ayak ile varış durağı arasındaki kuleler) */
export function bridgeAt(towerId: number) {
  for (const b of BRIDGES) {
    const a = stopTowerId(b.foot), z = stopTowerId(b.to);
    if (towerId > a && towerId < z) return { bridge: b, progress: (towerId - a) / (z - a) };
  }
  return null;
}
export function bridgeFromFoot(k: number) {
  return BRIDGES.find((b) => b.foot === k) ?? null;
}
export function bridgeArrivingAt(k: number) {
  return BRIDGES.find((b) => b.to === k) ?? null;
}

/** Gecenin başladığı durak (skyStepForStops 4): pijama anı burada (Ortaköy). */
export const NIGHT_STOP = 5;

/** Gökyüzü adımı (0 sabah … 4 gece). 2026-11-16 kullanıcı: "gün batımını daha erkene alalım":
 *  0-1 sabah, 2 öğle, 3 ikindi, 4 (Beylerbeyi + Boğaziçi Köprüsü) gün batımı, 5 Ortaköy'den itibaren gece.
 *  (önceki: 1-4 sabah, 5-8 öğle, 9-10 ikindi, 11 gün batımı, 12+ gece) */
export function skyStepForStops(k: number) {
  if (k <= 1) return 0;
  if (k <= 4) return k - 1;
  return 4;
}

/** k. durağın (1'den başlar) kule kimliği. */
export function stopTowerId(k: number) {
  "worklet";
  return FIRST_STOP + (k - 1) * STOP_EVERY;
}

/** Bu kuleye kadar (dahil) geçilen durak sayısı. */
export function stopsPassed(id: number) {
  "worklet";
  if (id < FIRST_STOP) return 0;
  return 1 + Math.floor((id - FIRST_STOP) / STOP_EVERY);
}

export function isStopTower(id: number) {
  "worklet";
  return id >= FIRST_STOP && (id - FIRST_STOP) % STOP_EVERY === 0;
}

/** Zorluk basamağı 0..1: durak başına bir basamak, iskelede tavan. */
export function stopDifficulty(id: number) {
  "worklet";
  return Math.min(1, stopsPassed(id) / DIFFICULTY_CAP_STOP);
}

export function stopName(k: number) {
  if (k <= 0) return "";
  if (k <= STOP_NAMES.length) return STOP_NAMES[k - 1];
  return `Gece seferi ${k - FINAL_STOP}`;
}

/** Paylaşım kartpostalı için: "Üsküdar'a kadar geldim" (k = geçilen durak sayısı). */
export function reachedLine(k: number) {
  if (k <= 0) return null;
  if (k <= STOP_DATIVE.length) return `${STOP_DATIVE[k - 1]} kadar geldim`;
  return `Rumeli Feneri'ni geçtim, gece seferindeyim`;
}

/** Sonuç kartı için: "Galata'ya 4 kule kaldı" satırı. */
export function nextStopLine(lastTowerId: number) {
  const k = stopsPassed(lastTowerId) + 1;
  const left = stopTowerId(k) - lastTowerId;
  if (k <= STOP_DATIVE.length) return `${STOP_DATIVE[k - 1]} ${left} kule kaldı`;
  return `Sonraki gece durağına ${left} kule kaldı`;
}
